import { defineConsoleConfig } from "@hot-updater/console";
import { apiKeys } from "@hot-updater/server/plugins/api-keys";
import { insights } from "@hot-updater/server/plugins/insights";
import { remoteConfig } from "@hot-updater/server/plugins/remote-config";
import { supabaseDatabase, supabaseStorage } from "@hot-updater/supabase";

export default defineConsoleConfig(() => {
  const config = {
    supabaseUrl: process.env.SUPABASE_URL!,
    supabaseServiceRoleKey: process.env.SUPABASE_SERVICE_ROLE_KEY!,
  };

  return {
    database: supabaseDatabase(config),
    storage: supabaseStorage({
      ...config,
      bucketName: process.env.SUPABASE_BUCKET_NAME!,
    }),
    // The plugins the managed Supabase server runs: API keys, Insights, and Remote Config.
    plugins: [apiKeys(), insights(), remoteConfig()],
  };
});
