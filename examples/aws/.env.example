# Existing Hot Updater DynamoDB table and S3 bucket.
AWS_REGION=us-east-1
AWS_DYNAMODB_TABLE_NAME=your-existing-table
AWS_S3_BUCKET_NAME=your-existing-bucket

# Set this if your OTA backend uses CloudFront, so console writes invalidate it.
# AWS_CLOUDFRONT_DISTRIBUTION_ID=

# Omit credentials when using an attached AWS role or a local AWS profile.
# Otherwise add these through your host's private runtime environment settings.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=  # Required only for temporary credentials.
