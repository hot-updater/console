import { dynamoDB, s3Storage } from "@hot-updater/aws";
import { defineConsoleConfig } from "@hot-updater/console";
import { apiKeys } from "@hot-updater/server/plugins/api-keys";
import { insights } from "@hot-updater/server/plugins/insights";
import { remoteConfig } from "@hot-updater/server/plugins/remote-config";

export default defineConsoleConfig(() => ({
  database: dynamoDB({
    region: process.env.AWS_REGION!,
    tableName: process.env.AWS_DYNAMODB_TABLE_NAME!,
    cloudfrontDistributionId: process.env.AWS_CLOUDFRONT_DISTRIBUTION_ID,
  }),
  storage: s3Storage({
    region: process.env.AWS_REGION!,
    bucketName: process.env.AWS_S3_BUCKET_NAME!,
  }),
  // The plugins the managed AWS server runs: API keys, Insights, and Remote Config.
  plugins: [apiKeys(), insights(), remoteConfig()],
}));
