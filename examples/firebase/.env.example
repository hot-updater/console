# Existing Firebase project and Cloud Storage bucket; omit the gs:// prefix.
FIREBASE_PROJECT_ID=your-existing-project
FIREBASE_STORAGE_BUCKET=your-existing-bucket.firebasestorage.app

# Choose one credential source:
# - On Google Cloud, use the attached service identity (no variable needed).
# - For a private mounted file, set its absolute runtime path:
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# - On hosts such as Vercel, set the full JSON in the runtime secret store:
# FIREBASE_SERVICE_ACCOUNT_JSON=
