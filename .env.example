# Canonical public origin. Production deployments must use HTTPS.
BETTER_AUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Comma-separated full addresses. Domain names and wildcards are not accepted.
HOT_UPDATER_CONSOLE_ALLOWED_EMAILS=owner@example.com

# Configure at least one complete OAuth provider pair.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
