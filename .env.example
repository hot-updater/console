# Canonical public origin. Production deployments must use HTTPS.
BETTER_AUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Comma-separated full addresses. Configure at least one email or domain below.
HOT_UPDATER_CONSOLE_ALLOWED_EMAILS=owner@example.com

# Optional comma-separated domains (e.g. example.com,company.org).
# Allows verified emails at those exact domains; no @, wildcards, or implicit subdomains.
HOT_UPDATER_CONSOLE_ALLOWED_EMAIL_DOMAINS=

# Configure at least one complete OAuth provider pair.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Opens the vault's secrets, when console.config.ts lists vault(). Generate with:
# openssl rand -base64 32
# Keep it out of the environment that holds your database credentials and out of CI.
HOT_UPDATER_VAULT_MASTER_KEY=
