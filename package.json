{
  "name": "hot-updater-console",
  "version": "0.0.0",
  "private": true,
  "description": "Deployable Hot Updater Console",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "NODE_ENV=production vite build",
    "build:node": "NODE_ENV=production NITRO_PRESET=node_server vite build",
    "build:cloudflare": "NODE_ENV=production NITRO_PRESET=cloudflare_module vite build",
    "deploy:cloudflare": "pnpm build:cloudflare && wrangler deploy",
    "preview:cloudflare": "wrangler dev --port 3000",
    "cf:typegen": "wrangler types --strict-vars=false",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "test:cloudflare": "node scripts/smoke-console.mjs cloudflare",
    "test:type": "tsc --noEmit",
    "test:node": "node scripts/smoke-console.mjs node"
  },
  "dependencies": {
    "@hot-updater/console": "1.0.0-rc.8",
    "better-auth": "^1.6.23",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@hot-updater/cloudflare": "1.0.0-rc.5",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.0",
    "typescript": "^6.0.2",
    "vite": "8.0.8",
    "vitest": "4.1.4",
    "wrangler": "4.129.0"
  },
  "packageManager": "pnpm@11.6.0"
}
