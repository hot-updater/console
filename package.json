{
  "name": "hot-updater-console",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Deployable Hot Updater Console",
  "license": "MIT",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "NODE_ENV=production vite build",
    "build:node": "NODE_ENV=production NITRO_PRESET=node_server vite build",
    "build:cloudflare": "NODE_ENV=production NITRO_PRESET=cloudflare_module vite build",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "test:type": "tsc --noEmit"
  },
  "dependencies": {
    "@hot-updater/console": "https://pkg.pr.new/gronxb/hot-updater/@hot-updater/console@146654edf1a1da3087f68263ed8a094bfff3c688",
    "better-auth": "^1.6.23",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.0",
    "typescript": "^6.0.2",
    "vite": "8.0.8",
    "vitest": "4.1.4"
  }
}
